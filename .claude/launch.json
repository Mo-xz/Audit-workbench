{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--no-project",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--port",
        "8010",
        "--reload"
      ],
      "port": 8010,
      "autoPort": false
    },
    {
      "name": "frontend",
      "cwd": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5183",
        "--strictPort"
      ],
      "port": 5183
    },
    {
      "name": "frontend-alt",
      "cwd": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5184",
        "--strictPort"
      ],
      "port": 5184
    },
    {
      "name": "app",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--no-project",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "app-alt",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--no-project",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8011",
        "--reload"
      ],
      "port": 8011,
      "autoPort": false
    },
    {
      "name": "app-measure",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--no-project",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8012"
      ],
      "port": 8012,
      "autoPort": false
    },
    {
      "name": "replay-record",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--no-project",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8013"
      ],
      "port": 8013,
      "autoPort": false
    },
    {
      "name": "replay-offline",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--no-project",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8014"
      ],
      "env": {
        "LLM_REPLAY": "on",
        "LLM_REPLAY_SOURCE": "Workspaces/recordings/procurement.db",
        "GROQ_API_KEY": "",
        "OPENROUTER_API_KEY": "",
        "MISTRAL_API_KEY": "",
        "OPENCODE_API_KEY": "",
        "CEREBRAS_API_KEY": "",
        "LMSTUDIO_API_KEY": "",
        "GROQ_BASE_URL": "http://127.0.0.1:9",
        "OPENROUTER_BASE_URL": "http://127.0.0.1:9",
        "MISTRAL_BASE_URL": "http://127.0.0.1:9",
        "OPENCODE_BASE_URL": "http://127.0.0.1:9",
        "CEREBRAS_BASE_URL": "http://127.0.0.1:9",
        "LMSTUDIO_BASE_URL": "http://127.0.0.1:9"
      },
      "port": 8014,
      "autoPort": false
